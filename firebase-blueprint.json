{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Researcher or administrator account profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "organization": {
          "type": "string",
          "maxLength": 160
        },
        "researchFocus": {
          "type": "string",
          "maxLength": 240
        },
        "role": {
          "type": "string",
          "enum": ["researcher", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "emailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "role", "status", "emailVerified", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped notification for analysis completion, validation alerts, and exports",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "type": {
          "type": "string",
          "enum": ["info", "success", "warning", "error"]
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable audit trail of dataset uploads, analyses, report exports, and profile actions",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "resourceType": {
          "type": "string",
          "enum": ["auth", "dataset", "analysis", "report", "profile", "system"]
        },
        "resourceId": {
          "type": "string",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "action", "resourceType", "details", "createdAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Platform configuration controlled exclusively by verified administrators",
      "type": "object",
      "properties": {
        "maxFileSizeMb": {
          "type": "number"
        },
        "allowRegistration": {
          "type": "boolean"
        },
        "maintenanceMode": {
          "type": "boolean"
        },
        "defaultConfidenceThreshold": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["maxFileSizeMb", "allowRegistration", "maintenanceMode", "defaultConfidenceThreshold", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Server-managed administrator role document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private researcher and admin profile records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-owned platform notifications"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable activity and audit log entries"
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Admin-managed global platform settings"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator directory (read-only to owner/admins, write-locked on client)"
    }
  }
}
